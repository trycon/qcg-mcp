{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "Signature question",
  "description": "Drawn signature question",
  "allOf": [
    { "$ref": "base_question.json" },
    {
      "properties": {
        "answer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "signature" }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
