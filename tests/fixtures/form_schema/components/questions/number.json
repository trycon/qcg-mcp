{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "Number question",
  "description": "Numeric response question",
  "allOf": [
    { "$ref": "base_question.json" },
    {
      "properties": {
        "answer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "number" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min": { "type": "number" },
                "max": { "type": "number" }
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
