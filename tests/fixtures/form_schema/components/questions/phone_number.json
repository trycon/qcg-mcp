{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "Phone Number question",
  "description": "Phone number response question",
  "allOf": [
    { "$ref": "base_question.json" },
    {
      "properties": {
        "answer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "phoneNumber" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "placeholder": { "type": "string" }
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
