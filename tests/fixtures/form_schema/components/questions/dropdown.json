{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "Dropdown question",
  "description": "Single-select dropdown question",
  "allOf": [
    { "$ref": "base_question.json" },
    {
      "properties": {
        "answer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "dropdown" },
            "data": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["option"],
                "properties": {
                  "option": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "_id": { "type": "string", "description": "Stable client-generated key for this choice row, same purpose as base_question.json's top-level id -- optional for backward compatibility, and future-proofing if the builder starts emitting it here the way it already does for multiple_choice/checkboxes." }
                }
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
