{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "Separator Component",
  "description": "Reusable Separator component schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": {
      "type": "string",
      "enum": [
        "01",
        "02",
        "03",
        "04",
        "05",
        "06",
        "07",
        "08",
        "09"
      ]
    },
    "color": {
      "$ref": "style/separator.json#/properties/color"
    },
    "label": {
      "type": "string",
      "description": "Optional text shown in the centre of the separator — new-block-only field, no Angular precedent."
    },
    "separatorStyle": {
      "type": "object",
      "additionalProperties": false,
      "description": "Written by the new builder block instead of the flat 'color' field Angular uses.",
      "properties": {
        "color": {
          "type": "string"
        },
        "thickness": {
          "type": "number"
        },
        "spacing": {
          "type": "number"
        }
      }
    }
  }
}
