{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "Audio Player block",
  "description": "Embeddable audio player block for component pages. Same fields as audio main_page.",
  "type": "object",
  "additionalProperties": false,
  "required": ["files"],
  "properties": {
    "pageTitle": { "type": "string", "maxLength": 100 },
    "subHeading": { "type": "string", "maxLength": 200 },
    "pageLayout": {
      "type": "string",
      "enum": ["list", "grid"],
      "default": "list"
    },
    "allowFileDownload": { "type": "boolean" },
    "files": {
      "type": "array",
      "minItems": 0,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url"],
        "properties": {
          "url": {
            "type": "string",
            "anyOf": [{ "format": "uri" }, { "const": "" }],
            "description": "Empty string means no file uploaded yet (list-editor placeholder row before the user picks a track)."
          },
          "name": { "type": "string" },
          "fileName": { "type": "string" },
          "thumbnail": { "type": "string" },
          "description": { "type": "string" },
          "size": { "type": "number" }
        }
      }
    }
  }
}
