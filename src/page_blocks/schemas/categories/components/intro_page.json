{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "type": "object",
  "required": ["tagline", "time"],
  "additionalProperties": false,
  "properties": {
    "url": {
      "type": "string",
      "anyOf": [{ "format": "uri" }, { "const": "" }]
    },
    "tagline": { "type": "string" },
    "time": { "type": "number" },
    "redirectUrl": {
      "type": "string",
      "anyOf": [{ "format": "uri" }, { "const": "" }]
    }
  }
}
