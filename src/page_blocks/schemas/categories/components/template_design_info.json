{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "x-deprecated": true,
  "x-deprecated-since": "2026-06-14",
  "x-replacement": "QRCode.theme_overrides (DB-driven theme system; merged with theme.config_json at render time)",
  "x-removal-phase": "Phase 6 — after Angular UI cutover and migrate_design_info command",
  "title": "Template design info component",
  "description": "[legacy-angular-only] Validate template design info schema, sent only by the legacy Angular app's coupon/dynamicText/event/product/wedding category templates — remove once all QR codes are migrated off design_info (see x-removal-phase).",
  "type": "object",
  "required": [
    "background",
    "card",
    "button",
    "text"
  ],
  "additionalProperties": false,
  "properties": {
    "themeId": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        }
      ]
    },
    "background": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "solid",
            "gradient",
            "image"
          ]
        },
        "color": {
          "type": "string"
        },
        "gradient": {
          "type": "object",
          "required": [
            "color1",
            "color2",
            "styleType",
            "angle"
          ],
          "additionalProperties": false,
          "properties": {
            "color1": {
              "type": "string"
            },
            "color2": {
              "type": "string"
            },
            "styleType": {
              "type": "string",
              "enum": [
                "radial",
                "linear"
              ]
            },
            "angle": {
              "type": "number"
            }
          }
        },
        "image": {
          "type": "object",
          "required": [
            "url",
            "fit",
            "opacity"
          ],
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string"
            },
            "fit": {
              "type": "string",
              "enum": [
                "original-size",
                "repeating",
                "fit-to-width",
                "fit-to-height",
                "fit-to-screen"
              ]
            },
            "opacity": {
              "type": "number"
            }
          }
        }
      }
    },
    "card": {
      "type": "object",
      "required": [
        "color",
        "cornerRadius",
        "cardStroke",
        "strokeColor",
        "showDropShadow"
      ],
      "additionalProperties": false,
      "properties": {
        "color": {
          "type": "string"
        },
        "cornerRadius": {
          "type": "number"
        },
        "cardStroke": {
          "type": "number"
        },
        "strokeColor": {
          "type": "string"
        },
        "showDropShadow": {
          "type": "boolean"
        },
        "shadowColor": {
          "type": "string"
        },
        "shadowStyle": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "center"
          ]
        }
      }
    },
    "button": {
      "type": "object",
      "required": [
        "fillType",
        "color",
        "textColor",
        "cornerRadius",
        "fontFamily",
        "fontSize",
        "showDropShadow"
      ],
      "additionalProperties": false,
      "properties": {
        "fillType": {
          "type": "string",
          "enum": [
            "filled",
            "stroke"
          ]
        },
        "color": {
          "type": "string"
        },
        "textColor": {
          "type": "string"
        },
        "cornerRadius": {
          "type": "number"
        },
        "fontFamily": {
          "type": "string"
        },
        "fontSize": {
          "type": "number"
        },
        "showDropShadow": {
          "type": "boolean"
        },
        "shadowColor": {
          "type": "string"
        },
        "shadowStyle": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "center"
          ]
        }
      }
    },
    "text": {
      "type": "object",
      "required": [
        "headerTitle",
        "cardTitle",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "headerTitle": {
          "$ref": "#/definitions/textStyle"
        },
        "cardTitle": {
          "$ref": "#/definitions/textStyle"
        },
        "body": {
          "$ref": "#/definitions/textStyle"
        }
      }
    }
  },
  "definitions": {
    "textStyle": {
      "type": "object",
      "required": [
        "color",
        "fontFamily",
        "fontSize",
        "bold",
        "italic",
        "textAlign"
      ],
      "additionalProperties": false,
      "properties": {
        "color": {
          "type": "string"
        },
        "fontFamily": {
          "type": "string"
        },
        "fontSize": {
          "type": "number"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "textAlign": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ]
        }
      }
    }
  }
}
