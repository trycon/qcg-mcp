{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "v2 Block Item — per-block-type data dispatch",
  "description": "Shared by every page-type's blocks array (page-types/component-page.json, audio-page.json, image-page.json, document-page.json) via allOf + $ref, so a block's `data` is validated by exactly one schema regardless of which page type contains it — one root of truth instead of the old generic `data: {type: object}` placeholder. The type->schema mapping mirrors exactly what schema_validator.py's old Stage-3 per-block validation resolved at runtime: v2/components/<type>.json takes priority when it exists, else categories/components/<type>.json, generated by checking the actual files on disk (not guessed). `main_page` and `cover_page` have no schema file in either directory (confirmed) and are intentionally left with no dispatch branch here, matching the old code's forward-compatible skip for block types with no schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "data"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "data": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "rsvp_form" } } }, "then": { "properties": { "data": { "$ref": "components/rsvp_form.json" } } } },
    { "if": { "properties": { "type": { "const": "rsvp" } } }, "then": { "properties": { "data": { "$ref": "components/rsvp.json" } } } },
    { "if": { "properties": { "type": { "const": "social_media_profiles" } } }, "then": { "properties": { "data": { "$ref": "components/social_media_profiles.json" } } } },
    { "if": { "properties": { "type": { "const": "image_gallery" } } }, "then": { "properties": { "data": { "$ref": "components/image_gallery.json" } } } },

    { "if": { "properties": { "type": { "const": "about_us" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/about_us.json" } } } },
    { "if": { "properties": { "type": { "const": "audio_player" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/audio_player.json" } } } },
    { "if": { "properties": { "type": { "const": "auto_redirect" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/auto_redirect.json" } } } },
    { "if": { "properties": { "type": { "const": "banner_images" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/banner_images.json" } } } },
    { "if": { "properties": { "type": { "const": "brand_info" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/brand_info.json" } } } },
    { "if": { "properties": { "type": { "const": "button" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/button.json" } } } },
    { "if": { "properties": { "type": { "const": "company_branding" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/company_branding.json" } } } },
    { "if": { "properties": { "type": { "const": "contact_details" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/contact_details.json" } } } },
    { "if": { "properties": { "type": { "const": "contact_us" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/contact_us.json" } } } },
    { "if": { "properties": { "type": { "const": "couple_name" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/couple_name.json" } } } },
    { "if": { "properties": { "type": { "const": "coupon_details" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/coupon_details.json" } } } },
    { "if": { "properties": { "type": { "const": "custom_form" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/custom_form.json" } } } },
    { "if": { "properties": { "type": { "const": "custom_script" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/custom_script.json" } } } },
    { "if": { "properties": { "type": { "const": "description_box" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/description_box.json" } } } },
    { "if": { "properties": { "type": { "const": "document_viewer" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/document_viewer.json" } } } },
    { "if": { "properties": { "type": { "const": "event_schedule" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/event_schedule.json" } } } },
    { "if": { "properties": { "type": { "const": "event_venue" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/event_venue.json" } } } },
    { "if": { "properties": { "type": { "const": "feedback_info" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/feedback_info.json" } } } },
    { "if": { "properties": { "type": { "const": "file" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/file.json" } } } },
    { "if": { "properties": { "type": { "const": "footer_info" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/footer_info.json" } } } },
    { "if": { "properties": { "type": { "const": "gs1_info" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/gs1_info.json" } } } },
    { "if": { "properties": { "type": { "const": "intro_page" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/intro_page.json" } } } },
    { "if": { "properties": { "type": { "const": "logo_section" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/logo_section.json" } } } },
    { "if": { "properties": { "type": { "const": "map" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/map.json" } } } },
    { "if": { "properties": { "type": { "const": "menu_info" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/menu_info.json" } } } },
    { "if": { "properties": { "type": { "const": "page_header" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/page_header.json" } } } },
    { "if": { "properties": { "type": { "const": "page_title" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/page_title.json" } } } },
    { "if": { "properties": { "type": { "const": "profile_info" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/profile_info.json" } } } },
    { "if": { "properties": { "type": { "const": "property_listing" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/property_listing.json" } } } },
    { "if": { "properties": { "type": { "const": "real_estate_profile" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/real_estate_profile.json" } } } },
    { "if": { "properties": { "type": { "const": "review_us" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/review_us.json" } } } },
    { "if": { "properties": { "type": { "const": "separator" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/separator.json" } } } },
    { "if": { "properties": { "type": { "const": "social_sharing_buttons" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/social_sharing_buttons.json" } } } },
    { "if": { "properties": { "type": { "const": "start_page" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/start_page.json" } } } },
    { "if": { "properties": { "type": { "const": "success_page" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/success_page.json" } } } },
    { "if": { "properties": { "type": { "const": "video" } } }, "then": { "properties": { "data": { "$ref": "../categories/components/video.json" } } } }
  ]
}
