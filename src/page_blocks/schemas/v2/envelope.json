{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "v2 Multi-page Envelope",
  "description": "Top-level schema for a v2 multi-page QR code. Single-page QR codes use blocks at top level.",
  "type": "object",
  "additionalProperties": false,
  "required": ["theme_id", "pages"],
  "properties": {
    "theme_id": { "type": ["integer", "null"] },
    "theme_overrides": { "type": ["object", "null"] },
    "pageName": { "type": "string", "maxLength": 200 },
    "settings": { "$ref": "page-settings.json" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "page.json" }
    }
  }
}
